[Unit]
Description=Collect official MillionDollar Brain market observations
After=network-online.target postgresql.service mdb-web.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 50 -H x-mdb-collector-token:mdb-local-devnet-keeper-v1 -X POST http://127.0.0.1:3000/api/collect-market
