After=network-online.target postgresql.service mdb-anvil.service mdb-web.service
Wants=network-online.target
Conflicts=mdb-endurance-testnet.service

[Service]
Type=oneshot
User=hendo420
Group=hendo420
WorkingDirectory=/home/hendo420/projects/million-dollar-brain
EnvironmentFile=/etc/mdb/devnet.env
Environment=MDB_TORTURE_RPC_PORT=18550
Environment=MDB_TORTURE_WEB_PORT=3010
Environment=MDB_TORTURE_DURATION_SECONDS=7200
Environment=MDB_TORTURE_TRANSACTION_TARGET=10000
