[Unit]
Description=MillionDollar Brain local-devnet web application
After=network-online.target postgresql.service mdb-deploy.service
Wants=network-online.target
Requires=mdb-deploy.service

[Service]
Type=simple
User=hendo420
WorkingDirectory=/home/hendo420/projects/million-dollar-brain
EnvironmentFile=/etc/mdb/local.env
ExecStart=/home/hendo420/projects/million-dollar-brain/scripts/start-web.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
