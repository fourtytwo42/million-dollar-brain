[Unit]
Description=MillionDollar Brain constrained AI allocation cycle (local devnet)
After=mdb-web.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mdb/local.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 210 -H "x-mdb-cycle-token:${MDB_CYCLE_TOKEN}" -X POST http://127.0.0.1:3000/api/cycle
