[Unit]
Description=42 Braincells Robinhood mainnet canary web application
After=network-online.target postgresql.service mdb-rpc-failover-mainnet.service
Wants=network-online.target
Requires=mdb-rpc-failover-mainnet.service
ConditionPathExists=/home/hendo420/projects/million-dollar-brain/packages/contracts/deployments/mainnet-v5.json

[Service]
Type=simple
User=hendo420
WorkingDirectory=/home/hendo420/projects/million-dollar-brain
EnvironmentFile=/etc/mdb/mainnet.env
Environment=MDB_NETWORK_MODE=mainnet
Environment=PORT=3003
ExecStart=/home/hendo420/projects/million-dollar-brain/scripts/start-web.sh
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/hendo420/projects/million-dollar-brain/var/mainnet /home/hendo420/projects/million-dollar-brain/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
