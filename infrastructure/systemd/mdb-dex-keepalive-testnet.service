[Unit]
Description=Refresh 42 Braincells testnet DEX TWAP observations
After=mdb-rpc-failover-testnet.service
Requires=mdb-rpc-failover-testnet.service

[Service]
Type=oneshot
User=hendo420
WorkingDirectory=/home/hendo420/projects/million-dollar-brain
EnvironmentFile=/etc/mdb/testnet.env
Environment=MDB_NETWORK_MODE=testnet
ExecStart=/home/hendo420/projects/million-dollar-brain/scripts/run-dex-keepalive.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/hendo420/projects/million-dollar-brain/packages/contracts/broadcast /home/hendo420/projects/million-dollar-brain/packages/contracts/cache
