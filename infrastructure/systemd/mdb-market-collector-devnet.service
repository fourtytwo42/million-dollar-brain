[Unit]
Description=Collect official 42 Braincells market observations (devnet)
After=mdb-web-devnet.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mdb/devnet.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 50 -H "x-mdb-collector-token:${MDB_COLLECTOR_TOKEN}" -X POST http://127.0.0.1:3000/api/collect-market
