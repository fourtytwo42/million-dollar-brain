[Unit]
Description=Collect official MillionDollar Brain market observations (local)
After=mdb-web.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mdb/local.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 50 -H "x-mdb-collector-token:${MDB_COLLECTOR_TOKEN}" -X POST http://127.0.0.1:3000/api/collect-market
