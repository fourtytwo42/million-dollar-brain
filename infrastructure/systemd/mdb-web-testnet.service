[Unit]
Description=MillionDollar Brain Robinhood Testnet web application
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/home/hendo420/projects/million-dollar-brain/packages/contracts/deployments/testnet-v3.json

[Service]
Type=simple
User=hendo420
WorkingDirectory=/home/hendo420/projects/million-dollar-brain
EnvironmentFile=/etc/mdb/testnet.env
Environment=MDB_NETWORK_MODE=testnet
Environment=PORT=3001
ExecStart=/home/hendo420/projects/million-dollar-brain/scripts/start-web.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/hendo420/projects/million-dollar-brain/var/testnet-v3 /home/hendo420/projects/million-dollar-brain/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
