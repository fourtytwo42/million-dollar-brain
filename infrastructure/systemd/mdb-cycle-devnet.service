[Unit]
Description=42 Braincells constrained AI allocation cycle (devnet)
After=mdb-web-devnet.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mdb/devnet.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 210 -H "x-mdb-cycle-token:${MDB_CYCLE_TOKEN}" -X POST http://127.0.0.1:3000/api/cycle
