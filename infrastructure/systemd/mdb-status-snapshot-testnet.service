[Unit]
Description=Refresh the read-only 42 Braincells testnet DEX snapshot
After=mdb-web-testnet.service mdb-rpc-failover-testnet.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mdb/testnet.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 50 -H "x-mdb-snapshot-token:${MDB_COLLECTOR_TOKEN}" -X POST http://127.0.0.1:3001/api/refresh-status-snapshot
