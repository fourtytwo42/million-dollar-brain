{
  "name": "million-dollar-brain",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test:contracts": "forge test --root packages/contracts",
    "test:meme": "node --experimental-strip-types --test tests/meme-recap.test.ts",
    "test:portfolio-display": "node --experimental-strip-types --test tests/portfolio-display.test.ts",
    "test:capacity-policy": "node --experimental-strip-types --test tests/capacity-policy.test.ts",
    "test:cycle-history": "node --experimental-strip-types --test tests/cycle-history.test.ts",
    "test:portrait": "node --experimental-strip-types --test tests/portrait.test.ts",
    "test:piece-name": "node --experimental-strip-types --test tests/piece-name.test.ts",
    "test:brain-controls": "node --experimental-strip-types --test tests/brain-controls.test.ts",
    "test:brain-control-experience": "node --experimental-strip-types --test tests/brain-control-experience.test.ts",
    "test:brain-profile-v2": "node --experimental-strip-types --test tests/brain-profile-v2.test.ts",
    "test:brain-control-experience:uat": "node tests/brain-control-experience-uat.mjs",
    "test:compiled-brain": "node --experimental-strip-types --test tests/compiled-brain.test.ts",
    "test:decision-context": "node --experimental-strip-types --test tests/decision-context.test.ts",
    "test:asset-universe": "node --experimental-strip-types --test tests/asset-universe.test.ts",
    "test:market-data": "node --experimental-strip-types --test tests/market-data.test.ts",
    "test:network": "node --experimental-strip-types --test tests/network-policy.test.ts",
    "test:rpc-failover": "node --test tests/rpc-failover.test.mjs",
    "test:torture:devnet": "scripts/run-devnet-torture.sh",
    "test:wallet": "node --experimental-strip-types --test tests/wallet-dependencies.test.ts tests/admin-transaction-lock.test.ts tests/approval-retry.test.ts",
    "test:graduation": "node --test tests/qualification-window.test.mjs tests/mainnet-readiness.test.mjs tests/graduation-policy.test.mjs",
    "mainnet:candidate": "node scripts/build-mainnet-candidate.mjs",
    "format:check": "prettier --check .",
    "test:uat": "node tests/uat.mjs"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "axios": "1.19.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "ws": "8.21.1",
    "@rainbow-me/rainbowkit@2.2.11": {
      "cuer@0.0.3": {
        "qr": "0.5.5"
      }
    }
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "prettier": "3.9.6"
  }
}
